# BentoBabu Staging Test Suite Configuration Template
# Copy to .env.staging or export in your CI/CD runner

# Staging Environment URLs
STAGING_BASE_URL=http://127.0.0.1:5050/api/v1
STAGING_PORT=5050
STAGING_HOST=127.0.0.1

# Isolated Staging Database URI (MUST contain 'staging' or 'test'; NEVER use production)
STAGING_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bentobabu_staging?authSource=admin&retryWrites=true&w=majority

# Staging Test Customer Credentials
STAGING_CUSTOMER_EMAIL=staging.customer.loadtest@bentobabu.test
STAGING_CUSTOMER_PASSWORD=StagingTestPass123!
STAGING_CUSTOMER_PHONE=9876543210

# Staging Test Delivery Partner Credentials
STAGING_RIDER_1_EMAIL=staging.rider1@bentobabu.test
STAGING_RIDER_1_PASSWORD=StagingRiderPass123!
STAGING_RIDER_2_EMAIL=staging.rider2@bentobabu.test
STAGING_RIDER_2_PASSWORD=StagingRiderPass123!

# Staging Test Admin Credentials
STAGING_ADMIN_EMAIL=staging.admin@bentobabu.test
STAGING_ADMIN_PASSWORD=StagingAdminPass123!

# k6 Performance & Load Thresholds
K6_MAX_P50_MS=500
K6_MAX_P90_MS=1000
K6_MAX_P95_MS=1500
K6_MAX_P99_MS=2500
K6_MAX_ERROR_RATE=0.01

# Concurrency Profiles (comma-separated VU tiers to test)
K6_VU_TIERS=5,10,20,35,50
K6_STAGE_DURATION=15s
