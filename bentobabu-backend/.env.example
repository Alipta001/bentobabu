# Node Environment (development | test | production)
NODE_ENV=development

# Server Port & Host
PORT=5000
HOST=127.0.0.1

# MongoDB Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/bentobabu

# CORS Allowed Origins
# Development:
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Production (set in Render environment):
# FRONTEND_URL=https://bentobabu.com
# ADMIN_FRONTEND_URL=https://admin.bentobabu.com
# ALLOWED_ORIGINS=https://bentobabu.com,https://www.bentobabu.com,https://admin.bentobabu.com

# JWT Secret Keys & Expirations
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Cookie Security Settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
ACCESS_TOKEN_COOKIE_NAME=bb_access_token
REFRESH_TOKEN_COOKIE_NAME=bb_refresh_token

# CSRF Protection Secret
CSRF_SECRET=your_32_byte_random_csrf_secret_string

# Redis Connection & Distributed Caching
# Local development: redis://127.0.0.1:6379
# Upstash / Cloud TLS: rediss://default:<your-password>@<your-upstash-host>.upstash.io:6379
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true
# Optional: Set to 'false' only if custom/self-signed certificates require disabling TLS strict checking
# REDIS_TLS_REJECT_UNAUTHORIZED=true

# Razorpay Configuration (Test/Live Credentials)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret_placeholder

# Email Configuration (Resend HTTPS API)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_actual_resend_api_key
EMAIL_FROM=BentoBabu <verify@bentobabu.com>

# Legacy SMTP Configuration (Deprecated - replaced by RESEND_API_KEY)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASSWORD=re_your_actual_resend_api_key

# OTP Signup Verification Configuration
# Exactly one channel must be enabled (either OTP_EMAIL_ENABLED=true OR OTP_SMS_ENABLED=true)
OTP_EMAIL_ENABLED=true
OTP_SMS_ENABLED=false
OTP_HASH_SECRET=your_32_byte_random_otp_hash_secret_string
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3

# SMS Provider Configuration (when OTP_SMS_ENABLED=true)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=BENTOB

# WhatsApp Business Cloud API Configuration (Optional - Meta Cloud API)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_API_VERSION=v21.0

# Cloudinary Media Configuration (Food Images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cloudflare R2 Media Configuration (Food Videos - S3 Compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=bentobabu-media
R2_PUBLIC_BASE_URL=https://media.bentobabu.com
R2_REGION=auto
R2_UPLOAD_URL_EXPIRY_SECONDS=600

# Delivery OTP verification (true = mandatory, false = skip OTP)
# Default: true. Set to false in Render environment variables to disable.
DELIVERY_OTP_REQUIRED=true

