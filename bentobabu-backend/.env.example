# Node Environment (development | test | production)
NODE_ENV=development

# Server Port & Host
PORT=5000
HOST=127.0.0.1

# MongoDB Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/bentobabu

# CORS Allowed Origins
# Development:
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Production (set in Render environment):
# FRONTEND_URL=https://bentobabu.com
# ADMIN_FRONTEND_URL=https://admin.bentobabu.com
# ALLOWED_ORIGINS=https://bentobabu.com,https://www.bentobabu.com,https://admin.bentobabu.com

# JWT Secret Keys & Expirations
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Cookie Security Settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
ACCESS_TOKEN_COOKIE_NAME=bb_access_token
REFRESH_TOKEN_COOKIE_NAME=bb_refresh_token

# CSRF Protection Secret
CSRF_SECRET=your_32_byte_random_csrf_secret_string

# Redis Connection & Distributed Caching
# Local development: redis://127.0.0.1:6379
# Upstash / Cloud TLS: rediss://default:<your-password>@<your-upstash-host>.upstash.io:6379
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true
# Optional: Set to 'false' only if custom/self-signed certificates require disabling TLS strict checking
# REDIS_TLS_REJECT_UNAUTHORIZED=true

# Razorpay Configuration (Test/Live Credentials)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret_placeholder

# Email SMTP Configuration (Optional in Dev/Test)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=bentobabuofficial@gmail.com
SMTP_PASSWORD=your_email_app_password
EMAIL_FROM=BentoBabu <bentobabuofficial@gmail.com>

# WhatsApp Business Cloud API Configuration (Optional - Meta Cloud API)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_API_VERSION=v21.0
