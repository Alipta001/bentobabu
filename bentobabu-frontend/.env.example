# Central Backend API Configuration
# Production: https://api.bentobabu.com/api/v1
# Local Dev:   http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=https://api.bentobabu.com/api/v1

# Razorpay Online Payment Gateway Key ID (Public Key only, NEVER put secret key in frontend!)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere

# Website Canonical Host (Production: https://bentobabu.com)
NEXT_PUBLIC_SITE_URL=https://bentobabu.com

# MSG91 OTP Widget ID (Public widget identifier)
NEXT_PUBLIC_MSG91_WIDGET_ID=366b746e3258343539303835

# MSG91 OTP Widget Token Auth (Server-side environment variable - keep prefix as NEXT_MSG91_TOKEN_AUTH)
NEXT_MSG91_TOKEN_AUTH=your_msg91_widget_token_auth_here

# Google Identity Services (GIS) Client ID (Public client identifier)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Customer Signup Mobile OTP Requirement (true = require MSG91 phone verification, false = email-only OTP)
NEXT_PUBLIC_OTP_SMS_ENABLED=false

