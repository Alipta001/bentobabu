# Central Backend API Configuration
# Production: https://api.bentobabu.com/api/v1
# Local Dev:   http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=https://api.bentobabu.com/api/v1

# Razorpay Online Payment Gateway Key ID (Public Key only, NEVER put secret key in frontend!)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere

# Website Canonical Host (Production: https://bentobabu.com)
NEXT_PUBLIC_SITE_URL=https://bentobabu.com

